{
  "name": "tistory-plugins",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "format": "biome format --write .",
    "check": "biome check .",
    "build": "esbuild src/inline-code/index.ts src/katex/index.ts --bundle --minify --platform=browser --target=es2022 --format=iife --outbase=src --outdir=dist --entry-names=[dir]/index.min",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "esbuild": "^0.27.4",
    "happy-dom": "^20.8.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
