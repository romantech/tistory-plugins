{
  "name": "tistory-plugins",
  "description": "Tistory blog plugins distributed via jsDelivr CDN",
  "version": "0.1.91",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romantech/tistory-plugins.git"
  },
  "homepage": "https://github.com/romantech/tistory-plugins#readme",
  "bugs": {
    "url": "https://github.com/romantech/tistory-plugins/issues"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:write": "biome check . --write",
    "build": "node scripts/build-dist.mjs",
    "preview": "node scripts/preview-dist.mjs https://romantech.net/1079 --watch",
    "purge:jsdelivr": "node scripts/purge-jsdelivr.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.11.2",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
